.vscode
.DS_Store
Thumbs.db

# Tmp files
tmp/

# Build outputs
**/dist/
**/.composer/

# Dependencies
**/node_modules/
**/vendor/

# Lockfiles — yarn.lock commité pour builds CI reproductibles
package-lock.json

# Template's local-dev Composer override generates its own lock — never committed
# (production-shape composer.json regenerates a fresh composer.lock during release builds)
templates/acf-wordpress-theme/composer.lock
templates/acf-wordpress-theme/composer.local.lock

# Local-only secrets (never committed)
.npmrc.local
auth.json
.composer/auth.json

.npmrc

# Dev environment (generated by `pnpm dev:*`, never committed)
dev-wp/
.deploy-tmp/

# Environment files (per-developer secrets)
.env
.env.local
.env.*.local

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/

# Misc
*.log

# Local-only notes / scratch docs (not part of the public docs tree).
# Filename convention: *.local.md so any file matching the pattern stays
# uncommittable without per-file maintenance of this list.
*.local.md

# Dev plugin cache (downloaded zips, never committed)
scripts/dev/cache/

# Worktree shared assets (uploads cache, etc. — see scripts/dev/worktree-postcreate.sh)
.adui-shared/


# WordPress
wordpress/wp-content/*
!wordpress/wp-content/themes
wordpress/wp-content/themes/*
!wordpress/wp-content/themes/atelierdesign
wordpress/wp-content/themes/atelierdesign/.vite-dev-mode

npm-debug.log*
yarn-debug.log*
yarn-error.log*

php.ini
# Vite cache local
.vite/
