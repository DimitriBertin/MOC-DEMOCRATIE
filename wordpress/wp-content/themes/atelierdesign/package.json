{
  "name": "adui-wp-acf-theme",
  "version": "0.1.0-beta",
  "description": "Atelier Design Wordpress theme with ACF",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"webpack --config webpack.dev.js\" \"browser-sync start --config bs-config.js\"",
    "dev:webpack": "webpack --config webpack.dev.js",
    "dev:browsersync": "browser-sync start --config bs-config.js",
    "build": "webpack --config webpack.prod.js",
    "serve": "browser-sync start --config bs-config.js",
    "adui:init": "cd ad-ui/core && pnpm install",
    "adui:dev": "cd ad-ui/core && pnpm dev",
    "adui:build": "cd ad-ui/core && pnpm build"
  },
  "keywords": [],
  "author": "Atelier Design",
  "license": "private",
  "packageManager": "pnpm@10.9.0",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.4",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "~3.x.x",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "lenis": "^1.3.11",
    "swiper": "^12.0.2"
  }
}
